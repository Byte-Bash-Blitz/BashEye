# ==============================================================================
# BashEye — Environment Configuration Template (.env.example)
# ==============================================================================

# Discord Bot Credentials & Server IDs
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=1163002451746623528
ALLOWED_GUILD_IDS=1163002451746623528
TRACKED_CATEGORY_IDS=1351223065354178722

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Bot Authentication (Bot user credentials for Supabase RLS operations)
email=basheye@bytebashblitz.org
mailpass=your_bot_user_password_here

# OpenRouter / AI Feedback API
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Express API Server Port (Default: 3000, fallback to 3001 if occupied)
PORT=3000

# ==============================================================================
# Multi-Clan System Configuration
# ==============================================================================

# Clan Roles
CLAN_AURA7F_ROLE_ID=1364585878282043479
CLAN_BELMONT_ROLE_ID=1364584863880974386
